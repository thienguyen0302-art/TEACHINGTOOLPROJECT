# Firebase
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_APP_ID=

# Judge0 - RapidAPI Extra CE
JUDGE0_URL=https://judge0-extra-ce.p.rapidapi.com
JUDGE0_API_HOST=judge0-extra-ce.p.rapidapi.com
JUDGE0_API_KEY=
JUDGE0_CPP_ID=2
JUDGE0_PYTHON_ID=28

JUDGE0_AUTH_TOKEN=
JUDGE_PORT=3001
APP_ORIGIN=http://localhost:5173

# Self-hosted Judge0 example:
# JUDGE0_URL=http://127.0.0.1:2358
# JUDGE0_API_HOST=
# JUDGE0_API_KEY=
# JUDGE0_AUTH_TOKEN=
# JUDGE0_CPP_ID=54
# JUDGE0_PYTHON_ID=71

# AI Tutor - OpenAI, server only (never VITE_*)
AI_PROVIDER=openai
AI_API_URL=https://api.openai.com/v1
OPENAI_API_KEY=
AI_MODEL=gpt-5.4-mini

# Production backend (Cloud Run): bật xác thực Firebase ID token
# REQUIRE_AUTH=true
# FIREBASE_PROJECT_ID=<id-project-firebase>
# APP_ORIGIN=https://<id-project-firebase>.web.app

# Contest/Authoring: REQUIRED even in local development; same project as VITE_FB_PROJECT_ID.
# FIREBASE_PROJECT_ID=<id-project-firebase>
# Backend uses ADC: gcloud auth application-default login (local), Cloud Run service account (prod).
# Never put Admin credentials in VITE_* variables or commit a service account JSON.

# Same economical model for PDF analysis and reference-test preparation.
AI_PDF_MODEL=gpt-5.4-mini

# Optional legacy Gemini: set AI_PROVIDER=gemini, its base URL/models and AI_API_KEY.
# AI_API_KEY=
