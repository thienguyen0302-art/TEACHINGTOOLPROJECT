{
  "name": "teachingtoolproject",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "prebuild": "npm run validate:content",
    "build": "vite build",
    "lint": "eslint .",
    "validate:content": "python3 scripts/validate_content.py",
    "test:content": "python3 -m unittest discover -s scripts -p 'test_*.py'",
    "validate:examples": "python3 scripts/validate_content.py --run-code",
    "preview": "vite preview",
    "judge:dev": "node --env-file-if-exists=.env.local server/index.js",
    "test:judge": "node --test server/judge.test.js",
    "dev:web": "vite",
    "test:ai": "node --test server/aiTutor.test.js",
    "test:progress": "node --test server/submissionProgress.test.js",
    "test:platform": "node --test server/platform.test.js",
    "test:lesson": "node --test server/lessonSelfCheck.test.js server/lessonCompletion.test.js",
    "test:contest": "node --test server/contest.test.js",
    "test:authoring": "node --test server/problemAuthoring.test.js",
    "test:rules": "node --test server/contestRules.test.js",
    "import:kiengiang": "node --env-file-if-exists=.env.local scripts/import-kien-giang-hsg.mjs",
    "test:series": "node --test scripts/import-kien-giang-hsg.test.mjs",
    "test:global-ai": "node --test server/globalChat.test.js",
    "test:global-ai:browser": "node scripts/global-chat-browser/browser.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "playwright": "^1.64.0",
    "vite": "^8.3.0"
  }
}
