rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    // Role "teacher" chỉ được gán thủ công trong Firebase Console (users/{uid}.role = "teacher").
    function isTeacher() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'teacher';
    }
    function validScore(v) { return v is number && v >= 0 && v <= 100; }

    // Hồ sơ: chủ sở hữu đọc/ghi, nhưng KHÔNG được tự đặt hay đổi `role`.
    match /users/{uid} {
      allow read: if isOwner(uid) || isTeacher();
      allow create: if isOwner(uid) && !('role' in request.resource.data);
      allow update: if isOwner(uid) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);

      match /progress/{id} {
        allow read: if isOwner(uid) || isTeacher();
        allow create, update: if isOwner(uid) && validScore(request.resource.data.quizScore);
      }

      match /submissions/{id} {
        allow read: if isOwner(uid) || isTeacher();
        allow create, update: if isOwner(uid) && validScore(request.resource.data.bestScore);
      }

      match /exams/{id} {
        allow read: if isOwner(uid) || isTeacher();
        allow create: if isOwner(uid) && validScore(request.resource.data.score);
      }

      match /daily/{day} {
        allow read: if isOwner(uid) || isTeacher();
        allow create, update: if isOwner(uid);
      }

      match /goals/{id} {
        allow read, write: if isOwner(uid) || isTeacher();
      }

      match /contestHistory/{contestId} {
        allow read, write: if isOwner(uid) || isTeacher();
      }

      match /contestSubmissions/{subId} {
        allow read, write: if isOwner(uid) || isTeacher();
      }
    }

    // Bảng xếp hạng Contest HSG: Đồng bộ giữa tất cả tài khoản dựa trên tổng điểm thi contest
    match /contestLeaderboard/{uid} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    // Bảng xếp hạng đề thi thật: mọi người đã đăng nhập được đọc; chỉ chủ sở hữu ghi dòng của mình.
    match /leaderboards/{lang}/entries/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid) && lang in ['cpp', 'python']
        && request.resource.data.uid == uid
        && request.resource.data.total is number
        && request.resource.data.total >= 0 && request.resource.data.total <= 100000;
    }

    // Giáo viên đọc tiến độ toàn lớp bằng collectionGroup('progress').
    match /{path=**}/progress/{id} {
      allow read: if isTeacher();
    }

    // Thông báo lớp học: công khai đọc (để realtime listener không bị lỗi khi auth pending); người dùng đăng nhập được đăng/quản lý
    match /announcements/{id} {
      allow read: if true;
      allow create, update, delete: if signedIn();
    }

    // Đánh giá người dùng: Công khai đọc đánh giá đã duyệt và đồng ý chia sẻ; người dùng quản lý đánh giá của mình; giáo viên kiểm duyệt.
    match /reviews/{uid} {
      allow read: if (resource.data.status == 'approved' && resource.data.isPublicConsent == true)
                  || isOwner(uid)
                  || isTeacher();
      allow create, update: if (isOwner(uid) && request.resource.data.uid == uid) || isTeacher();
      allow delete: if isOwner(uid) || isTeacher();
    }

    // Góp ý báo lỗi: Người dùng đăng nhập gửi và đọc báo cáo của mình; Giáo viên/Admin đọc và xử lý tất cả
    match /bugReports/{id} {
      allow read: if isTeacher() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn();
      allow update, delete: if isTeacher();
    }
    // New authoring uses the authenticated backend so slug/lock checks are atomic.
    function unlocked(problemId) {
      return !exists(/databases/$(database)/documents/problemLocks/$(problemId)) ||
        get(/databases/$(database)/documents/problemLocks/$(problemId)).data.until <= request.time;
    }
    function validPublicProblem(d, id) {
      return d.keys().hasOnly(['title','slug','difficulty','tags','statement','inputDescription','outputDescription','constraints','samples','allowedLanguages','starterCode','status','createdBy','createdAt','updatedAt']) &&
        d.status in ['draft','published'] && d.title is string && d.slug is string &&
        d.samples is list && d.samples.size() >= 1 && d.samples.size() <= 10 &&
        d.allowedLanguages is list && d.allowedLanguages.size() > 0 && d.allowedLanguages.hasOnly(['cpp','python']) &&
        get(/databases/$(database)/documents/problemSlugs/$(d.slug)).data.problemId == id &&
        (d.status == 'draft' || get(/databases/$(database)/documents/problemSecrets/$(id)).data.hiddenTests.size() > 0);
    }
    match /problems/{id} {
      allow read: if isTeacher() || (signedIn() && resource.data.status == 'published');
      allow create: if isTeacher() && unlocked(id) && validPublicProblem(request.resource.data, id) && request.resource.data.createdBy == request.auth.uid;
      allow update: if isTeacher() && unlocked(id) && validPublicProblem(request.resource.data, id) && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if false;
    }
    match /problemSecrets/{id} {
      allow read: if isTeacher();
      allow create, update: if isTeacher() && unlocked(id) &&
        request.resource.data.keys().hasOnly(['hiddenTests','updatedAt']) &&
        request.resource.data.hiddenTests is list && request.resource.data.hiddenTests.size() <= 50 &&
        (get(/databases/$(database)/documents/problems/$(id)).data.status == 'draft' || request.resource.data.hiddenTests.size() > 0);
      allow delete: if false;
    }
    match /problemSlugs/{slug} { allow read, write: if false; }
    match /problemLocks/{id} { allow read: if isTeacher(); allow write: if false; }
    match /contests/{contestId} {
      allow read: if isTeacher() || (signedIn() && resource.data.status == 'published');
      // Direct client writes can only touch drafts. Publish/configure scheduled
      // contests through Admin transactions to establish all problem locks.
      allow create: if isTeacher() && request.resource.data.status == 'draft' &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.keys().hasOnly(['title','description','status','startAt','durationMinutes','scoringMode','problems','createdBy','createdAt','updatedAt']);
      allow update: if isTeacher() && resource.data.status == 'draft' && request.resource.data.status == 'draft' &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.keys().hasOnly(['title','description','status','startAt','durationMinutes','scoringMode','problems','createdBy','createdAt','updatedAt']);
      allow delete: if false;
      match /submissions/{submissionId} {
        allow read: if isTeacher() || (signedIn() && resource.data.uid == request.auth.uid &&
          get(/databases/$(database)/documents/contests/$(contestId)).data.status == 'published');
        allow write: if false;
      }
      match /scoreboard/{uid} {
        allow read: if isTeacher() || (signedIn() && get(/databases/$(database)/documents/contests/$(contestId)).data.status == 'published');
        allow write: if false;
      }
    }
  }
}
