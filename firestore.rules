rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    // Role "teacher" chỉ được gán thủ công trong Firebase Console (users/{uid}.role = "teacher").
    function isTeacher() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'teacher';
    }
    function validScore(v) { return v is number && v >= 0 && v <= 100; }

    // Hồ sơ: chủ sở hữu đọc/ghi, nhưng KHÔNG được tự đặt hay đổi `role`.
    match /users/{uid} {
      allow read: if isOwner(uid) || isTeacher();
      allow create: if isOwner(uid) && !('role' in request.resource.data);
      allow update: if isOwner(uid) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);

      match /progress/{id} {
        allow read: if isOwner(uid) || isTeacher();
        allow create, update: if isOwner(uid) && validScore(request.resource.data.quizScore);
      }

      match /submissions/{id} {
        allow read: if isOwner(uid) || isTeacher();
        allow create, update: if isOwner(uid) && validScore(request.resource.data.bestScore);
      }

      match /exams/{id} {
        allow read: if isOwner(uid) || isTeacher();
        allow create: if isOwner(uid) && validScore(request.resource.data.score);
      }

      match /daily/{day} {
        allow read: if isOwner(uid) || isTeacher();
        allow create, update: if isOwner(uid);
      }
    }

    // Bảng xếp hạng đề thi thật: mọi người đã đăng nhập được đọc; chỉ chủ sở hữu ghi dòng của mình.
    match /leaderboards/{lang}/entries/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid) && lang in ['cpp', 'python']
        && request.resource.data.uid == uid
        && request.resource.data.total is number
        && request.resource.data.total >= 0 && request.resource.data.total <= 100000;
    }

    // Giáo viên đọc tiến độ toàn lớp bằng collectionGroup('progress').
    match /{path=**}/progress/{id} {
      allow read: if isTeacher();
    }

    // Thông báo lớp học: mọi người đăng nhập đọc được; chỉ giáo viên được tạo, sửa, xóa
    match /announcements/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isTeacher();
    }

    // Đánh giá người dùng: Công khai đọc đánh giá đã duyệt và đồng ý chia sẻ; người dùng quản lý đánh giá của mình; giáo viên kiểm duyệt.
    match /reviews/{uid} {
      allow read: if (resource.data.status == 'approved' && resource.data.isPublicConsent == true)
                  || isOwner(uid)
                  || isTeacher();
      allow create, update: if (isOwner(uid) && request.resource.data.uid == uid) || isTeacher();
      allow delete: if isOwner(uid) || isTeacher();
    }
  }
}
