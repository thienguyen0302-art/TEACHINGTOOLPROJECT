rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    // Role "teacher" chỉ được gán thủ công trong Firebase Console (users/{uid}.role = "teacher").
    function isTeacher() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'teacher';
    }
    function validScore(v) { return v is number && v >= 0 && v <= 100; }

    // Hồ sơ: chủ sở hữu đọc/ghi, nhưng KHÔNG được tự đặt hay đổi `role`.
    match /users/{uid} {
      allow read: if isOwner(uid) || isTeacher();
      allow create: if isOwner(uid) && !('role' in request.resource.data);
      allow update: if isOwner(uid) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);

      match /progress/{id} {
        allow read: if isOwner(uid) || isTeacher();
        allow create, update: if isOwner(uid) && validScore(request.resource.data.quizScore);
      }

      match /submissions/{id} {
        allow read: if isOwner(uid) || isTeacher();
        allow create, update: if isOwner(uid) && validScore(request.resource.data.bestScore);
      }

      match /exams/{id} {
        allow read: if isOwner(uid) || isTeacher();
        allow create: if isOwner(uid) && validScore(request.resource.data.score);
      }

      match /daily/{day} {
        allow read: if isOwner(uid) || isTeacher();
        allow create, update: if isOwner(uid);
      }
    }

    // Authoring writes go through the authenticated teacher backend. This also
    // enforces unique slugs, publish validation and fairness locks atomically.
    match /problems/{id} {
      allow read: if isTeacher() || (signedIn() && resource.data.published == true);
      allow write: if false;
    }
    match /problemSecrets/{id} {
      allow read: if isTeacher();
      allow write: if false;
    }
    match /problemSlugs/{slug} { allow read, write: if false; }
    function publishedContest(id) {
      return get(/databases/$(database)/documents/contests/$(id)).data.status == 'published';
    }
    match /contests/{id} {
      allow read: if isTeacher() || (signedIn() && resource.data.status == 'published');
      allow write: if false;
      match /submissions/{submissionId} {
        allow read: if isTeacher() || (signedIn() && resource.data.uid == request.auth.uid);
        allow write: if false;
      }
      match /scoreboard/{uid} {
        allow read: if isTeacher() || (signedIn() && publishedContest(id));
        allow write: if false;
      }
    }

    // Giáo viên đọc tiến độ toàn lớp bằng collectionGroup('progress').
    match /{path=**}/progress/{id} {
      allow read: if isTeacher();
    }
  }
}
